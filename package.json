{
  "name": "x-plus",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Userscript that adds translation, video download and many quality-of-life improvements to X (x.com)",
  "author": "NemoKing1210",
  "license": "MIT",
  "homepage": "https://github.com/NemoKing1210/x-plus",
  "bugs": {
    "url": "https://github.com/NemoKing1210/x-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NemoKing1210/x-plus.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-dist.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "ci": "npm run check:i18n && npm run build && npm run verify:artifacts",
    "preview": "vite preview",
    "harness": "node dev/harness/serve.mjs"
  },
  "devDependencies": {
    "terser": "^5.49.0",
    "vite": "^6.0.0",
    "vite-plugin-monkey": "^5.0.0"
